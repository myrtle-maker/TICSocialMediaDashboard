generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("POSTGRES_PRISMA_URL")
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

model Account {
  id                String   @id @default(cuid())
  platform          String
  platformAccountId String
  handle            String
  displayName       String
  profileImageUrl   String?
  bio               String?
  followers         Int      @default(0)
  following         Int      @default(0)
  totalPosts        Int      @default(0)
  verified          Boolean  @default(false)
  accountType       String   @default("business")
  category          String?
  externalUrl       String?
  lastScrapedAt     DateTime?
  createdAt         DateTime @default(now())

  posts     Post[]
  snapshots AccountSnapshot[]

  @@unique([platform, handle])
  @@map("accounts")
}

model AccountSnapshot {
  id         String   @id @default(cuid())
  accountId  String
  followers  Int
  following  Int
  totalPosts Int
  snapshotAt DateTime @default(now())

  account    Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
  @@index([snapshotAt])
  @@map("account_snapshots")
}

model Post {
  id              String   @id @default(cuid())
  platformPostId  String
  platform        String
  accountId       String
  contentType     String
  caption         String
  hashtags        String[]
  mentions        String[]
  mediaUrls       String[]
  thumbnailUrl    String?
  permalink       String

  hookText        String
  hookType        String
  hookScore       Float    @default(0)

  likes           Int      @default(0)
  comments        Int      @default(0)
  shares          Int      @default(0)
  saves           Int      @default(0)
  views           Int      @default(0)
  impressions     Int?
  reach           Int?

  engagementRate  Float    @default(0)
  viralityScore   Float    @default(0)

  platformMeta    Json     @default("{}")

  annotation      String?  @default("")

  publishedAt     DateTime
  scrapedAt       DateTime @default(now())

  account         Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  alerts          PerformanceAlert[]

  @@unique([platform, platformPostId])
  @@index([platform])
  @@index([accountId])
  @@index([publishedAt])
  @@index([hookType])
  @@index([contentType])
  @@map("posts")
}

model Setting {
  id    String @id @default(cuid())
  key   String @unique
  value String

  @@map("settings")
}

model ScrapeJob {
  id            String    @id @default(cuid())
  platform      String
  accountId     String
  apifyRunId    String
  apifyActorId  String
  status        String    @default("pending")
  postsScraped  Int       @default(0)
  startedAt     DateTime  @default(now())
  completedAt   DateTime?
  errorMessage  String?

  @@index([accountId])
  @@index([status])
  @@map("scrape_jobs")
}

model Competitor {
  id              String   @id @default(cuid())
  platform        String
  handle          String
  displayName     String
  profileImageUrl String?
  followers       Int      @default(0)
  lastScrapedAt   DateTime?
  createdAt       DateTime @default(now())

  posts CompetitorPost[]

  @@unique([platform, handle])
  @@map("competitors")
}

model CompetitorPost {
  id              String   @id @default(cuid())
  platformPostId  String
  platform        String
  competitorId    String
  contentType     String
  caption         String
  hashtags        String[]
  hookText        String
  hookType        String
  likes           Int      @default(0)
  comments        Int      @default(0)
  shares          Int      @default(0)
  saves           Int      @default(0)
  views           Int      @default(0)
  engagementRate  Float    @default(0)
  publishedAt     DateTime
  scrapedAt       DateTime @default(now())

  competitor      Competitor @relation(fields: [competitorId], references: [id], onDelete: Cascade)

  @@unique([platform, platformPostId])
  @@index([competitorId])
  @@index([platform])
  @@map("competitor_posts")
}

model PerformanceAlert {
  id          String   @id @default(cuid())
  postId      String
  alertType   String   // "overperforming" | "underperforming"
  sentAt      DateTime @default(now())

  post        Post     @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([postId, alertType])
  @@index([sentAt])
  @@map("performance_alerts")
}

model KpiTarget {
  id        String   @id @default(cuid())
  metric    String   // "engagementRate" | "views" | "likes" | "comments" | "shares" | "saves" | "posts"
  period    String   // "monthly" | "weekly"
  platform  String?  // null = all platforms
  target    Float
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([metric, period, platform])
  @@map("kpi_targets")
}

model EmailSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  @@map("email_subscribers")
}

model ContentPillar {
  id          String     @id @default(cuid())
  name        String
  description String?
  color       String     @default("#6366f1")
  sortOrder   Int        @default(0)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  ideas       PostIdea[]

  @@map("content_pillars")
}

model PostIdea {
  id              String        @id @default(cuid())
  pillarId        String
  title           String
  notes           String        @default("")
  platform        String?
  contentType     String?
  hookType        String?
  targetHashtags  String[]
  keywords        String[]
  status          String        @default("idea")
  scheduledPostId String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  pillar          ContentPillar @relation(fields: [pillarId], references: [id], onDelete: Cascade)

  @@index([pillarId])
  @@index([status])
  @@map("post_ideas")
}

model Board {
  id          String      @id @default(cuid())
  name        String
  description String?
  color       String      @default("#6366f1")
  sortOrder   Int         @default(0)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  lists       BoardList[]

  @@map("boards")
}

model BoardList {
  id        String      @id @default(cuid())
  boardId   String
  name      String
  color     String?
  sortOrder Int         @default(0)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  board     Board       @relation(fields: [boardId], references: [id], onDelete: Cascade)
  cards     BoardCard[]

  @@index([boardId])
  @@map("board_lists")
}

model BoardCard {
  id          String    @id @default(cuid())
  listId      String
  title       String
  description String    @default("")
  platform    String?
  contentType String?
  priority    String    @default("medium")
  labels      String[]
  links       Json      @default("[]")
  dueDate     DateTime?
  assignee    String?
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  list        BoardList @relation(fields: [listId], references: [id], onDelete: Cascade)

  @@index([listId])
  @@map("board_cards")
}

model ScheduledPost {
  id          String   @id @default(cuid())
  platform    String
  contentType String
  hookType    String?
  caption     String   @default("")
  notes       String   @default("")
  scheduledAt DateTime
  status      String   @default("planned")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([scheduledAt])
  @@index([platform])
  @@index([status])
  @@map("scheduled_posts")
}
