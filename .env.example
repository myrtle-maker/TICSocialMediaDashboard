# Apify API token for social media scraping
APIFY_API_TOKEN=

# PostgreSQL connection string
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/tic_social_insights

# Vercel Cron secret (protects cron endpoints)
CRON_SECRET=

# Public app name (exposed to the browser)
NEXT_PUBLIC_APP_NAME=TIC Social Media Insights
